# Vagrantfile — Ubuntu Server minimal (box: dfir-ubuntu-base)
# Provider: libvirt (Fedora host)
#
# Paramétrable via variables d'environnement, avec valeurs par défaut :
#   VM_NAME=mylab VM_RAM=4096 VM_CPUS=4 vagrant up
#
# Pour plusieurs VM Ubuntu en parallèle : dupliquer ce dossier (voir
# new-ubuntu-lab.sh à la racine du dossier ubuntu/), pas ce Vagrantfile —
# Vagrant isole son état par dossier (.vagrant/), donc un dossier = une VM.

Vagrant.configure("2") do |config|
  vm_name = ENV.fetch("VM_NAME", "ubuntu-lab")
  vm_ram  = ENV.fetch("VM_RAM", "2048").to_i
  vm_cpus = ENV.fetch("VM_CPUS", "2").to_i

  config.vm.box = "dfir-ubuntu-base"
  config.vm.hostname = vm_name
  config.vm.boot_timeout = 600
  config.ssh.username = "vagrant"
  config.ssh.insert_key = true

  config.vm.provider :libvirt do |lv|
    lv.memory = vm_ram
    lv.cpus = vm_cpus
    lv.storage_pool_name = "vms"
    lv.disk_bus = "virtio"
  end

  config.vm.provision "shell", inline: "echo 'Ubuntu lab ready: #{vm_name}'", run: "always"
end
